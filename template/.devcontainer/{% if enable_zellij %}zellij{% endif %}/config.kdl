// Zellij configuration (generated by copier-claude-code-devcontainer)
//
// Two status-bar layouts are shipped in layouts/:
//   - zjstatus       (default) -> uses the zjstatus plugin
//   - zj-status-bar           -> uses the zj-status-bar plugin
// Switch at launch with:  zellij --layout zj-status-bar
//
// On first launch each plugin asks for permissions: focus the status pane and press `y`.

default_layout "zjstatus"
pane_frames false
